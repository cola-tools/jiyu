# ─────────────────────────────────────────────────────────────
#  服务端环境变量（复制为 .env 后修改）
# ─────────────────────────────────────────────────────────────

# 服务监听端口（Railway / Render 会自动注入 PORT，留空则用 3000）
PORT=3000
NODE_ENV=development

# ── MySQL 连接 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=linux_study
# 云数据库一般需要开启 SSL：true / false
DB_SSL=false

# ── 允许跨域的前端来源（逗号分隔）──
# 部署到 GitHub Pages 后填你的域名，例如：
#   https://yourname.github.io,https://study.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 登录令牌有效期（小时）
TOKEN_TTL_HOURS=720
